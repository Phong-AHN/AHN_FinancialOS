# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Bearer secret guarding /api/cron/* (Vercel Cron sends it automatically)
CRON_SECRET=

# ─── Supabase (Day 1) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by `npm run db:push`
SUPABASE_DB_URL=

# ─── QuickBooks Online (Day 2) ────────────────────────────────────────────────
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Intuit has exactly two: sandbox | production. NOT "development" - that is
# a Plaid value, and using it here points sandbox keys at the live API.
QBO_ENVIRONMENT=production
QBO_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback

# ─── Plaid (Day 3) ────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production. Plaid RETIRED the "development" environment -
# development.plaid.com no longer resolves. Real bank data needs Production
# access, which is an application with a review, not a self-serve toggle.
PLAID_ENV=sandbox

# ─── Stripe (Day 3) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ─── Alerts (Day 4) ───────────────────────────────────────────────────────────
# Channel names MUST be quoted. An unquoted value starting with # is read as
# an inline comment and arrives EMPTY, which silently drops the app back to
# the incoming webhook - one channel for everything, and messages the bot
# cannot delete. Quoting is the whole fix.
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL="#ahn-finance-alerts"
SLACK_WEBHOOK_URL=
# Optional per-severity routing (spec 5). Falls back to SLACK_DEFAULT_CHANNEL.
SLACK_CHANNEL_CRITICAL=
SLACK_CHANNEL_WARNING=
SLACK_CHANNEL_DIGEST=
# Slash commands (spec 5). From the Slack app's Basic Information page.
# Without it /api/slack/commands refuses every request rather than answering
# unauthenticated - the body's user_id proves nothing, the sender wrote it.
SLACK_SIGNING_SECRET=

# ─── VEEM (spec 2, Philippines payroll) ─────────────────────────────────────
# From the Veem developer portal. Client-credentials OAuth: the app exchanges
# these for a token itself, so there is no redirect flow and nothing to click.
VEEM_CLIENT_ID=
VEEM_CLIENT_SECRET=
# Optional. Your own Veem account id, which is what tells a payment OUT from a
# payment IN. Without it every payment is treated as outgoing - correct for
# Philippines payroll, wrong the day somebody pays AHN through Veem.
VEEM_ACCOUNT_ID=
# Defaults to https://api.veem.com, which is the host that answers. Veem's
# documented sandbox (sandbox-api.veem.com) serves an HTML sign-in page on
# every path including /oauth/token, so there is no sandbox to point at.
VEEM_API_BASE=

# What "today" means. AHN operates from Vietnam; Vercel runs in UTC, and between
# midnight and 07:00 local the two disagree about the date. Stored dates stay
# UTC either way - this only decides what the app calls "now".
# Keep it the same as the worker's TZ so the schedule and the dashboard agree.
BUSINESS_TIME_ZONE=Asia/Ho_Chi_Minh

# A transaction older than this is marked as seen without alerting. Stops the
# first sync - roughly six months of history - from firing hundreds of alerts
# at once about money that moved in March. Default 3.
ALERT_MAX_AGE_DAYS=3

RESEND_API_KEY=
ALERT_EMAIL_FROM=AHN Financial OS <alerts@example.com>
ALERT_EMAIL_TO=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# ── Finverse (Vietnamese banks) ────────────────────────────────────────────
# The only route to a Vietnamese bank today: VietinBank's sandbox needs a
# registered application and Techcombank has no public one. Finverse already
# covers Techcombank, Vietcombank and VP Bank.
#   Sign up at https://finverse.com -> dashboard -> credentials
FINVERSE_CLIENT_ID=
FINVERSE_CLIENT_SECRET=
# "sandbox" (default) or "production"
FINVERSE_ENV=sandbox
# Where Finverse returns the person after they sign in at their bank. Must match
# the URI registered with Finverse character for character.
FINVERSE_REDIRECT_URI=http://localhost:3000/api/integrations/finverse/callback

# ── VietinBank iConnect — ERP Statement API ────────────────────────────────
# The corporate route, and the one that reaches AHN's money: Finverse lists
# both VietinBank and Techcombank as INDIVIDUAL accounts only.
#
# Spec: docs/api-specs/vietinbank-statement-1.0.0.json
# Endpoint: POST https://sandbox.vietinbank.vn/vtb/openbanking/erp/v1/statement/inquiry
#
#   Register at https://openapi.vietinbank.vn, create an application, and the
#   two keys below are issued instantly. Authentication is NOT OAuth2 — these
#   go straight into the X-IBM-Client-Id and X-IBM-Client-Secret headers.
VIETINBANK_CLIENT_ID=
VIETINBANK_CLIENT_SECRET=

# The statement API answers for ONE account per call, so it has to be told
# which. The sandbox example uses 114000121964.
VIETINBANK_ACCOUNT_NUMBER=

# Partner identifiers VietinBank assigns (Mã nhà cung cấp dịch vụ, Mã merchant).
# A wrong one is answered with a status code inside a 200 response rather than
# an HTTP error, so it fails quietly unless something looks.
VIETINBANK_PROVIDER_ID=
VIETINBANK_MERCHANT_ID=

# "sandbox" (default) or "production". Anything unrecognised stays on sandbox.
# The specification lists only the sandbox host, so production ALSO needs
# VIETINBANK_API_BASE — there is no address to fall back to.
VIETINBANK_ENV=sandbox
VIETINBANK_API_BASE=

# Rarely changed. Defaults: D (demand deposit), ERP, 1.
VIETINBANK_ACCOUNT_TYPE=
VIETINBANK_CHANNEL=
VIETINBANK_MODEL=
