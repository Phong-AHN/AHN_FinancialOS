# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Bearer secret guarding /api/cron/* (Vercel Cron sends it automatically)
CRON_SECRET=

# ─── Supabase (Day 1) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by `npm run db:push`
SUPABASE_DB_URL=

# ─── QuickBooks Online (Day 2) ────────────────────────────────────────────────
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Intuit has exactly two: sandbox | production. NOT "development" - that is
# a Plaid value, and using it here points sandbox keys at the live API.
QBO_ENVIRONMENT=production
QBO_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback

# ─── Plaid (Day 3) ────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production. Plaid RETIRED the "development" environment -
# development.plaid.com no longer resolves. Real bank data needs Production
# access, which is an application with a review, not a self-serve toggle.
PLAID_ENV=sandbox

# ─── Stripe (Day 3) ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

# ─── Alerts (Day 4) ───────────────────────────────────────────────────────────
# Channel names MUST be quoted. An unquoted value starting with # is read as
# an inline comment and arrives EMPTY, which silently drops the app back to
# the incoming webhook - one channel for everything, and messages the bot
# cannot delete. Quoting is the whole fix.
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL="#ahn-finance-alerts"
SLACK_WEBHOOK_URL=
# Optional per-severity routing (spec 5). Falls back to SLACK_DEFAULT_CHANNEL.
SLACK_CHANNEL_CRITICAL=
SLACK_CHANNEL_WARNING=
SLACK_CHANNEL_DIGEST=

# A transaction older than this is marked as seen without alerting. Stops the
# first sync - roughly six months of history - from firing hundreds of alerts
# at once about money that moved in March. Default 3.
ALERT_MAX_AGE_DAYS=3

RESEND_API_KEY=
ALERT_EMAIL_FROM=AHN Financial OS <alerts@example.com>
ALERT_EMAIL_TO=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=
